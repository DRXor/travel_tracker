<h1>Новая поездка</h1>

<% if @trip.errors.any? %>
  <div>
    <h2>Не удалось создать поездку:</h2>

    <ul>
      <% @trip.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @trip, local: true do |f| %>
  <div>
    <%= f.label :name, "Название поездки" %>
    <%= f.text_field :name, required: true %>
  </div>

  <div>
    <%= f.label :destination, "Направление" %>
    <%= f.text_field :destination, required: true %>
  </div>

  <div>
    <%= f.label :start_date, "Дата начала" %>
    <%= f.date_field :start_date, required: true %>
  </div>

  <div>
    <%= f.label :end_date, "Дата окончания" %>
    <%= f.date_field :end_date, required: true %>
  </div>

  <div>
    <%= f.label :description, "Описание" %>
    <%= f.text_area :description, rows: 5 %>
  </div>

  <div>
    <%= f.submit "Создать поездку" %>
  </div>
<% end %>

<p>
  <%= link_to "← Назад к поездкам", trips_path %>
</p>