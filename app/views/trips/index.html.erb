<% content_for :title, "Мои поездки — TravelTracker" %>

<div class="page-heading">
  <div>
    <p class="ui-kit__eyebrow">Твоя коллекция путешествий</p>
    <h1>Мои поездки</h1>
    <p>Все твои планы и направления в одном месте.</p>
  </div>

  <%= link_to "＋ Создать поездку", new_trip_path, class: "button" %>
</div>

<% if @trips.empty? %>
  <section class="card" style="text-align: center; padding: 40px 24px;">
    <div style="font-size: 2.5rem; margin-bottom: 12px;" aria-hidden="true">✈</div>
    <h2>Пока нет поездок</h2>
    <p>Создай первую поездку — и здесь появятся твои планы.</p>
    <div class="inline-actions" style="justify-content: center;">
      <%= link_to "Создать первую поездку", new_trip_path, class: "button" %>
    </div>
  </section>
<% else %>
  <div class="card-grid">
    <%= render partial: "trip_card", collection: @trips, as: :trip %>
  </div>
<% end %>

<p style="margin-top: 28px;">
  <%= link_to "← На главную", root_path %>
</p>
