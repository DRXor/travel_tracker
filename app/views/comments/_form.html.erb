<div id="comment_form">
  <%= form_with model: [trip, comment] do |f| %>
    <% if comment.errors.any? %>
      <div class="errors">
        <ul>
          <% comment.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :body, "Новый комментарий" %>
      <%= f.text_area :body, rows: 3, placeholder: "Например: не забыть зонт" %>
    </div>

    <%= f.button "Отправить", class: "button" %>
  <% end %>
</div>