<%= turbo_frame_tag dom_id(@comment) do %>
  <%= form_with model: [@trip, @comment] do |f| %>
    <% if @comment.errors.any? %>
      <div class="errors">
        <ul>
          <% @comment.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.text_area :body, rows: 3, id: dom_id(@comment, :body), "aria-label": "Текст комментария" %>
    </div>

    <div class="inline-actions">
      <%= f.button "Сохранить", class: "button button--small" %>
      <%= link_to "Отмена", trip_path(@trip), class: "button button--secondary button--small" %>
    </div>
  <% end %>
<% end %>