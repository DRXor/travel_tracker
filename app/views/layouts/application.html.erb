<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for(:title) || "TravelTracker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="TravelTracker">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <%= link_to root_path, class: "brand" do %>
          <span class="brand__icon">T</span>
          <span>TravelTracker</span>
        <% end %>

        <nav class="site-nav" aria-label="Основная навигация">
          <%= link_to "Главная", root_path, class: "nav-link" %>
          <%= link_to "UI Kit", ui_kit_path, class: "nav-link" %>

          <% if logged_in? %>
            <%= link_to "Мои поездки", trips_path, class: "nav-link" %>
            <%= link_to "Новая поездка", new_trip_path, class: "button button--small" %>
          <% else %>
            <%= link_to "Войти", login_path, class: "nav-link" %>
            <%= link_to "Регистрация", signup_path, class: "button button--small" %>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="container page-content">
      <% if notice.present? %>
        <div class="flash flash--notice" role="status">
          <%= notice %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="container">
        TravelTracker · Планируй путешествия с удовольствием
      </div>
    </footer>
  </body>
</html>
